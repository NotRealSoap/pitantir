DATABASE_URL=postgresql://pitantir:pitantir@localhost:5432/pitantir

# For the Next.js dev server, copy keys to apps/web/.env.local (or use /settings)
PITPANDA_API_KEY=
HYPIXEL_API_KEY=
ITEM_DATA_PROVIDER=pitpanda

# Worker (apps/worker)
# WORKER_ID=worker-1
# WORKER_POLL_MS=2000
# JOB_LEASE_MS=60000
# INVENTORY_SOURCE=mock
# INVENTORY_SOURCE=hypixel_pit

# Discord downwatch (optional — worker polls a channel for !downwatch commands)
# DISCORD_BOT_TOKEN=
# DISCORD_DOWNWATCH_CHANNEL_ID=
# DISCORD_DOWNWATCH_ROLE_ID=
# DISCORD_OPS_ALERT_USER_ID=
# DOWNWATCH_DISCORD_POLL_MS=5000

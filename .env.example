# Copy to .env and fill in. Never commit the real file.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# API key from https://developer.hypixel.net
HYPIXEL_API_KEY=

# --- optional ---------------------------------------------------------------

# Text prefix, used when ENABLE_PREFIX_COMMANDS is true.
COMMAND_PREFIX=z!
# Prefix commands need the privileged message content intent, so they are off
# by default. Slash commands work either way.
ENABLE_PREFIX_COMMANDS=false

# Sync slash commands to one guild instead of globally. Guild syncs appear
# immediately, global syncs can take up to an hour. Set this while developing.
DEV_GUILD_ID=

# How long a cached player counts as fresh, in seconds.
CACHE_TTL_SECONDS=300
# How long a username -> UUID mapping is reused, in seconds.
NAME_TTL_SECONDS=86400
# Where the SQLite cache lives.
CACHE_PATH=data/cache.sqlite3
# Rows shown by the rankings command.
LEADERBOARD_SIZE=10
# Timeout for Mojang and Hypixel requests, in seconds.
REQUEST_TIMEOUT_SECONDS=10

# Override the fonts used on the cards. Leave blank to auto-detect a system font.
FONT_REGULAR=
FONT_BOLD=

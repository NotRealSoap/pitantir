# Copy to repo root as `.env` on the VPS (never commit real secrets).
#   cp deploy/env.production.example .env

POSTGRES_USER=pitantir
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=pitantir

# Host port for the Next.js UI / API (Tampermonkey points here).
PITANTIR_PORT=3000

# Same keys you used on the Mac (Settings page can also store some of these).
PITPANDA_API_KEY=
HYPIXEL_API_KEY=
ITEM_DATA_PROVIDER=pitpanda

INVENTORY_SOURCE=hypixel_pit
WORKER_ID=vps-worker-1

# Optional Discord (Downwatch / ops)
# DISCORD_BOT_TOKEN=
# DISCORD_DOWNWATCH_CHANNEL_ID=
# DISCORD_DOWNWATCH_ROLE_ID=
# DISCORD_OPS_ALERT_USER_ID=
# DOWNWATCH_DISCORD_POLL_MS=5000
